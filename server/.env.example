PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Preserve your existing Garmin key and Android token; never copy them into client/.
GARMIN_API_KEY=
HEALTH_SYNC_TOKEN=
GARMIN_TIMEZONE=Europe/Ljubljana
# Generate with npm run hash-password. Keep the quotes around the hash.
DASHBOARD_PASSWORD_HASH=
# Generate a separate random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
DASHBOARD_ORIGIN=http://localhost:5173
# Optional: defaults to server/data/stridehub.db. Relative paths use the server cwd.
# DB_PATH=./data/stridehub.db
# Production behind Nginx on the same host only:
# TRUST_PROXY=loopback
