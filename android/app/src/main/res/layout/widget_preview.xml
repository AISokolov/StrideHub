    android:orientation="vertical" android:padding="16dp" android:background="#172033">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#60A5FA" android:textSize="18sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_steps_placeholder" android:textColor="#FFFFFF" android:textSize="18sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sleep_placeholder" android:textColor="#FFFFFF" android:textSize="16sp" />
</LinearLayout>
